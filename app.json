{
  "expo": {
    "name": "Nexus",
    "slug": "nexus-ios",
    "owner": "emrekici",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nexus",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emreekici.nexus",
      "buildNumber": "2",
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Nexus verwendet Face ID, um deine persönlichen Inhalte zu schützen."
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nexus verwendet Face ID, um deine persönlichen Inhalte zu schützen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111f",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "d36b581e-d0b5-4c10-a094-633018af6edd"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
